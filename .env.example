# Salin ke .env lalu isi rahasia:  cp .env.example .env
# Generate nilai acak:             openssl rand -hex 32
POSTGRES_USER=ticketpass
POSTGRES_PASSWORD=ganti_dengan_hex_acak
POSTGRES_DB=ticketpass

REDIS_PASSWORD=ganti_dengan_hex_acak

JWT_SECRET=ganti_dengan_hex_acak
# Pepper untuk HMAC-SHA256(NIK). JANGAN diganti setelah ada data, hash lama jadi tidak cocok.
NIK_HMAC_PEPPER=ganti_dengan_hex_acak
# Kunci AES-256-GCM: tepat 64 karakter hex (32 byte)
NIK_AES_KEY=ganti_dengan_64_hex
